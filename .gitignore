node_modules/
# 本地数据一律不入库：anime.db 里有你的追番列表 / 进度 / 手动修正（不可重建），
# backups 是它的历史快照。⚠ 别只忽略 *.db —— SQLite 的 -wal / -shm 里同样有数据，
# 少写这一条会把你 4MB 左右的 WAL 一起传上去。
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
data/backups/
data/cache/
data/snapshots/
data/probe-*/
data/*.html
# 离线 UI 预览页（scripts/preview-ui.ts 生成，含内嵌海报，几 MB，不入库）
data/_preview/
# data/ 下的 markdown 是排查/清理的一次性报告（含你库里的真实番名与 key），
# 与 .scratch/ 同理：是实现过程产物，不是源码。
data/*.md
*.log
.DS_Store
.venv/
# 工程技能的本地状态：issue / spec / 分诊记录都在这里，默认不入库（想版本化就删掉这行）
.scratch/
